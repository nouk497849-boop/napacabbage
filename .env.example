# Required for real alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for persistent baselines, quota usage, and alert cooldowns in GitHub Actions
DATABASE_URL=

# Optional data source keys
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
SEARCHAPI_KEY=
KIWI_API_KEY=
SKYSCANNER_API_KEY=
SKYSCANNER_ENABLED=false

# Search defaults
ORIGINS=TPE,TSA,KHH,RMQ,TNN
CURRENCY=TWD
ADULTS=1
MIN_DAYS_AHEAD=14
MAX_DAYS_AHEAD=365
STAY_LENGTHS=3,5,7,10,14,21
CABINS=economy,business,first
SCAN_FREQUENCY_HOURS=3
SEARCHAPI_EXPLORE_LIMIT=3
SEARCHAPI_CALENDAR_LIMIT=6
SEARCHAPI_CALENDAR_DESTINATIONS=NRT,HND,KIX,ICN,HKG,BKK,SIN,KUL,MNL,SGN,DAD,HAN,DPS,CGK,SYD,MEL,LAX,SFO,YVR,SEA,HNL,LHR,CDG,FRA,AMS,IST,DXB
SEARCHAPI_CALENDAR_OUTBOUND_WINDOW_DAYS=7
SEARCHAPI_CALENDAR_WINDOW_STEP_DAYS=45

# Keep the free-tier posture conservative. Set a limit to 0 to disable a source.
TRAVELPAYOUTS_DAILY_LIMIT=240
TRAVELPAYOUTS_MONTHLY_LIMIT=3000
AMADEUS_DAILY_LIMIT=80
AMADEUS_MONTHLY_LIMIT=1000
SEARCHAPI_DAILY_LIMIT=3
SEARCHAPI_MONTHLY_LIMIT=250
KIWI_DAILY_LIMIT=60
KIWI_MONTHLY_LIMIT=1000
SKYSCANNER_DAILY_LIMIT=0
SKYSCANNER_MONTHLY_LIMIT=0

# Alert behavior
REQUIRE_VERIFIED_ALERTS=false
NOTIFY_NO_DEALS=true
NO_DEAL_CANDIDATE_LIMIT=8
MAX_ALERTS_PER_RUN=8
TOP_VERIFY_LIMIT=18
ALERT_COOLDOWN_HOURS=24
ALERT_PRICE_DROP_PCT=5
